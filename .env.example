# Blueprint to CAD deployment settings. infra/install.sh writes the real file to
# /opt/blueprint-cad/.env (mode 600) with generated secrets. Values with spaces
# must be quoted.

# Public origin users browse to (Cloudflare Tunnel -> http://localhost:9999)
PUBLIC_URL=https://3d.8westit.com
HTTP_PORT=9999
HTTP_BIND=0.0.0.0
DJANGO_ALLOWED_HOSTS=3d.8westit.com,localhost,127.0.0.1
CSRF_EXTRA_TRUSTED_ORIGINS=
# Leave empty to follow PUBLIC_URL (https -> secure cookies). Set to false only
# for plain-http LAN testing.
COOKIE_SECURE=

DJANGO_SECRET_KEY=change-me
POSTGRES_DB=bpcad
POSTGRES_USER=bpcad
POSTGRES_PASSWORD=change-me

# invite_only (pilot) or open
SIGNUP_MODE=invite_only

# Email relay for sign-in codes and invitations. Empty EMAIL_HOST = local outbox
# (read with: sudo bpcad outbox).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL="Blueprint to CAD <no-reply@8westit.com>"

TIME_ZONE=America/Chicago
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=20

# Where data lives on the host (database, drawings, outbox, backups)
DATA_DIR=/opt/blueprint-cad/data
# Images: pulled from GHCR when available, otherwise built on the VM
IMAGE_REGISTRY=ghcr.io/seckcey/3d-model-app
IMAGE_TAG=latest
GIT_SHA=dev

# Backups
BACKUP_KEEP=14
BACKUP_PASSPHRASE_FILE=/root/.bpcad-backup-passphrase
# Optional: command that copies each new backup off the VM, e.g.
# BACKUP_OFFSITE_CMD="rclone copy --no-traverse {file} offsite:blueprint-cad"
BACKUP_OFFSITE_CMD=
