{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3d.8westit.com/schemas/feature-spec-1.schema.json",
  "title": "FeatureSpec v1",
  "description": "Constrained, allowlisted description of a single machined part. The AI (Phase 2+) or a person proposes this data; trusted code builds the solid from it. No field is ever executed as code.",
  "type": "object",
  "required": ["schema", "family", "part", "units", "dimensions", "features"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "feature-spec/1"},
    "family": {"enum": ["plate", "prismatic", "turned"]},
    "part": {
      "type": "object",
      "required": ["number", "revision"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": "string", "minLength": 1, "maxLength": 80},
        "revision": {"type": "string", "maxLength": 20},
        "name": {"type": "string", "maxLength": 200}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["benchmark", "drawing", "manual"]},
        "file_sha256": {"type": ["string", "null"]},
        "note": {"type": "string"}
      }
    },
    "units": {"enum": ["in", "mm"], "description": "Units of every length in this spec (the drawing's units)."},
    "projection": {"enum": ["third_angle", "first_angle"]},
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designation": {"type": "string"},
        "density_g_cm3": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "datums": {
      "type": "object",
      "description": "Model origin is the intersection of datums A/B/C (block parts: bottom/left/front faces; turned parts: axis and end face).",
      "additionalProperties": {"type": "string"}
    },
    "dimensions": {
      "type": "object",
      "propertyNames": {"pattern": "^D[0-9]{1,4}$"},
      "additionalProperties": {"$ref": "#/$defs/dimension"}
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/feature"}
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "expect": {
      "type": "object",
      "description": "Independent expectations written from the drawing (benchmarks), not from the builder.",
      "additionalProperties": false,
      "properties": {
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "volume": {"type": "number"},
        "solids": {"type": "integer"},
        "assumes": {"type": "object"}
      }
    }
  },
  "$defs": {
    "value": {
      "description": "A literal length/angle or a reference to a dimension (resolved at nominal or mid-tolerance).",
      "oneOf": [
        {"type": "number"},
        {"type": "object", "required": ["dim"], "additionalProperties": false,
         "properties": {"dim": {"type": "string", "pattern": "^D[0-9]{1,4}$"}}}
      ]
    },
    "point2": {"type": "array", "items": {"$ref": "#/$defs/value"}, "minItems": 2, "maxItems": 2},
    "dimension": {
      "type": "object",
      "required": ["nominal"],
      "additionalProperties": false,
      "properties": {
        "nominal": {"type": "number"},
        "upper": {"type": "number", "description": "Signed upper deviation, e.g. +0.0005"},
        "lower": {"type": "number", "description": "Signed lower deviation, e.g. -0.0000"},
        "tolerance_source": {"enum": ["explicit", "title_block", "iso2768", "iso286", "basic", "reference", "unknown"]},
        "kind": {"enum": ["linear", "diameter", "radius", "depth", "angle", "chamfer", "location"]},
        "text": {"type": "string"},
        "critical": {"type": "boolean"},
        "source": {"type": "object"}
      }
    },
    "face": {"enum": ["top", "bottom", "front", "back", "left", "right", "end_top", "end_bottom"]},
    "thread": {
      "type": "object",
      "required": ["callout", "major", "tap_drill", "depth"],
      "additionalProperties": false,
      "properties": {
        "callout": {"type": "string"},
        "major": {"type": "number"},
        "minor": {"type": "number"},
        "tap_drill": {"type": "number"},
        "form_tap_drill": {"type": "number"},
        "depth": {"oneOf": [{"const": "thru"}, {"$ref": "#/$defs/value"}]}
      }
    },
    "feature": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,15}$"},
        "type": {"enum": ["block", "turned_profile", "step", "hole", "cross_hole", "pocket", "slot",
                          "chamfer", "end_chamfer", "fillet_edge", "groove"]},
        "dims": {"type": "array", "items": {"type": "string"}, "description": "Dimension IDs this feature satisfies (traceability)."}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "block"}}}, "then": {
          "required": ["size"],
          "properties": {"size": {"type": "array", "items": {"$ref": "#/$defs/value"}, "minItems": 3, "maxItems": 3}}}},
        {"if": {"properties": {"type": {"const": "turned_profile"}}}, "then": {
          "required": ["segments"],
          "properties": {"segments": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
            "type": "object", "required": ["diameter", "length"], "additionalProperties": false,
            "properties": {"diameter": {"$ref": "#/$defs/value"}, "length": {"$ref": "#/$defs/value"}}}}}}},
        {"if": {"properties": {"type": {"const": "step"}}}, "then": {
          "required": ["x", "y", "floor_z"],
          "properties": {"x": {"$ref": "#/$defs/point2"}, "y": {"$ref": "#/$defs/point2"}, "floor_z": {"$ref": "#/$defs/value"}}}},
        {"if": {"properties": {"type": {"const": "hole"}}}, "then": {
          "required": ["face", "positions", "diameter", "depth", "hole_type"],
          "properties": {
            "face": {"$ref": "#/$defs/face"},
            "from": {"$ref": "#/$defs/value"},
            "positions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/point2"}},
            "diameter": {"$ref": "#/$defs/value"},
            "depth": {"oneOf": [{"const": "thru"}, {"$ref": "#/$defs/value"}]},
            "point_angle": {"type": "number", "minimum": 60, "maximum": 180},
            "hole_type": {"enum": ["clearance", "drilled", "reamed", "tapped", "bored"]},
            "counterbore": {"type": "object", "required": ["diameter", "depth"], "additionalProperties": false,
              "properties": {"diameter": {"$ref": "#/$defs/value"}, "depth": {"$ref": "#/$defs/value"}}},
            "countersink": {"type": "object", "required": ["diameter", "angle"], "additionalProperties": false,
              "properties": {"diameter": {"$ref": "#/$defs/value"}, "angle": {"type": "number"}}},
            "thread": {"$ref": "#/$defs/thread"}}}},
        {"if": {"properties": {"type": {"const": "cross_hole"}}}, "then": {
          "required": ["z", "diameter", "axis"],
          "properties": {"z": {"$ref": "#/$defs/value"}, "diameter": {"$ref": "#/$defs/value"},
                         "axis": {"enum": ["x", "y"]}, "hole_type": {"enum": ["clearance", "drilled", "reamed"]}}}},
        {"if": {"properties": {"type": {"const": "pocket"}}}, "then": {
          "required": ["face", "center", "size", "depth"],
          "properties": {"face": {"const": "top"}, "center": {"$ref": "#/$defs/point2"},
                         "size": {"$ref": "#/$defs/point2"}, "depth": {"$ref": "#/$defs/value"},
                         "from": {"$ref": "#/$defs/value"}, "corner_radius": {"$ref": "#/$defs/value"}}}},
        {"if": {"properties": {"type": {"const": "slot"}}}, "then": {
          "required": ["face", "start", "end", "width", "depth"],
          "properties": {"face": {"const": "top"}, "start": {"$ref": "#/$defs/point2"}, "end": {"$ref": "#/$defs/point2"},
                         "width": {"$ref": "#/$defs/value"}, "from": {"$ref": "#/$defs/value"},
                         "depth": {"oneOf": [{"const": "thru"}, {"$ref": "#/$defs/value"}]}}}},
        {"if": {"properties": {"type": {"const": "chamfer"}}}, "then": {
          "required": ["edges", "size"],
          "properties": {"edges": {"enum": ["top_outer", "bottom_outer"]}, "size": {"$ref": "#/$defs/value"}}}},
        {"if": {"properties": {"type": {"const": "end_chamfer"}}}, "then": {
          "required": ["end", "size"],
          "properties": {"end": {"enum": ["top", "bottom"]}, "size": {"$ref": "#/$defs/value"}}}},
        {"if": {"properties": {"type": {"const": "fillet_edge"}}}, "then": {
          "required": ["along", "at", "radius"],
          "properties": {"along": {"enum": ["x", "y", "z"]}, "at": {"$ref": "#/$defs/point2"}, "radius": {"$ref": "#/$defs/value"}}}},
        {"if": {"properties": {"type": {"const": "groove"}}}, "then": {
          "required": ["z", "width", "root_diameter"],
          "properties": {"z": {"$ref": "#/$defs/value"}, "width": {"$ref": "#/$defs/value"}, "root_diameter": {"$ref": "#/$defs/value"}}}}
      ]
    }
  }
}
